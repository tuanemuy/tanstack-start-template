{
  "name": "tanstack-start-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsgo",
    "lint": "biome lint",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "vitest run",
    "test:domain": "vitest run app/core/application/${TEST_DOMAIN}",
    "db:generate": "drizzle-kit generate --config=./app/core/adapters/drizzleSqlite/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=./app/core/adapters/drizzleSqlite/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --host 0.0.0.0 --config=./app/core/adapters/drizzleSqlite/drizzle.config.ts",
    "db:seed": "tsx ./app/core/adapters/drizzleSqlite/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@conform-to/react": "^1.16.0",
    "@conform-to/zod": "^1.16.0",
    "@hookform/resolvers": "^5.2.2",
    "@libsql/client": "^0.17.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tanstack/react-router": "^1.99.0",
    "@tanstack/react-start": "^1.99.0",
    "@types/nodemailer": "^7.0.9",
    "apexcharts": "^5.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.563.0",
    "neverthrow": "^8.2.0",
    "preline": "^4.0.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-resizable-panels": "^4.6.1",
    "recharts": "3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router-devtools": "^1.99.0",
    "@types/node": "^25.2.1",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260206.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitejs/plugin-rsc": "^0.5.0",
    "drizzle-kit": "^0.31.8",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "tinypool": "1.0.2"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
