{
  "name": "tanstack-start-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsgo",
    "lint": "biome lint",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "deploy": "vite build && wrangler deploy",
    "deploy:dry": "vite build && wrangler deploy --dry-run --outdir=dist/worker",
    "deploy:relay": "wrangler deploy -c wrangler.relay.toml",
    "deploy:relay:dry": "wrangler deploy -c wrangler.relay.toml --dry-run --outdir=dist/relay",
    "deploy:consumer": "wrangler deploy -c wrangler.consumer.toml",
    "deploy:consumer:dry": "wrangler deploy -c wrangler.consumer.toml --dry-run --outdir=dist/consumer",
    "deploy:pruner": "wrangler deploy -c wrangler.pruner.toml",
    "deploy:pruner:dry": "wrangler deploy -c wrangler.pruner.toml --dry-run --outdir=dist/pruner",
    "deploy:all": "pnpm deploy && pnpm deploy:relay && pnpm deploy:consumer && pnpm deploy:pruner",
    "deploy:all:dry": "pnpm deploy:dry && pnpm deploy:relay:dry && pnpm deploy:consumer:dry && pnpm deploy:pruner:dry",
    "db:generate": "drizzle-kit generate --config=./drizzle.config.ts",
    "db:apply:local": "wrangler d1 migrations apply tanstack-start-template-d1 --local",
    "db:apply:remote": "wrangler d1 migrations apply tanstack-start-template-d1 --remote",
    "db:execute:local": "wrangler d1 execute tanstack-start-template-d1 --local --file",
    "db:execute:remote": "wrangler d1 execute tanstack-start-template-d1 --remote --file"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.99.0",
    "@tanstack/react-start": "^1.99.0",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@cloudflare/vitest-pool-workers": "^0.16.0",
    "@cloudflare/workers-types": "^4.20260505.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router-devtools": "^1.99.0",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260206.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitejs/plugin-rsc": "^0.5.0",
    "drizzle-kit": "^0.31.8",
    "fast-check": "^4.7.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.1.5",
    "wrangler": "^4.88.0"
  },
  "pnpm": {
    "overrides": {
      "tinypool": "1.0.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
