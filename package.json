{
  "name": "tanstack-start-template",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types",
    "predev": "wrangler types",
    "build": "vite build",
    "dev": "vite dev",
    "preview": "vite preview",
    "typecheck": "tsgo",
    "lint": "biome lint",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "cf:types": "wrangler types",
    "deploy:staging": "vite build && wrangler deploy --config wrangler.staging.toml",
    "deploy:staging:dry": "vite build && wrangler deploy --config wrangler.staging.toml --dry-run --outdir=dist/worker",
    "deploy:staging:relay": "wrangler deploy --config wrangler.staging.toml --env relay",
    "deploy:staging:relay:dry": "wrangler deploy --config wrangler.staging.toml --env relay --dry-run --outdir=dist/relay",
    "deploy:staging:consumer": "wrangler deploy --config wrangler.staging.toml --env consumer",
    "deploy:staging:consumer:dry": "wrangler deploy --config wrangler.staging.toml --env consumer --dry-run --outdir=dist/consumer",
    "deploy:staging:pruner": "wrangler deploy --config wrangler.staging.toml --env pruner",
    "deploy:staging:pruner:dry": "wrangler deploy --config wrangler.staging.toml --env pruner --dry-run --outdir=dist/pruner",
    "deploy:staging:dlq": "wrangler deploy --config wrangler.staging.toml --env dlq",
    "deploy:staging:dlq:dry": "wrangler deploy --config wrangler.staging.toml --env dlq --dry-run --outdir=dist/dlq",
    "deploy:staging:all": "pnpm deploy:staging && pnpm deploy:staging:relay && pnpm deploy:staging:consumer && pnpm deploy:staging:pruner && pnpm deploy:staging:dlq",
    "deploy:staging:all:dry": "pnpm deploy:staging:dry && pnpm deploy:staging:relay:dry && pnpm deploy:staging:consumer:dry && pnpm deploy:staging:pruner:dry && pnpm deploy:staging:dlq:dry",
    "deploy:production": "vite build && wrangler deploy --config wrangler.production.toml",
    "deploy:production:dry": "vite build && wrangler deploy --config wrangler.production.toml --dry-run --outdir=dist/worker",
    "deploy:production:relay": "wrangler deploy --config wrangler.production.toml --env relay",
    "deploy:production:relay:dry": "wrangler deploy --config wrangler.production.toml --env relay --dry-run --outdir=dist/relay",
    "deploy:production:consumer": "wrangler deploy --config wrangler.production.toml --env consumer",
    "deploy:production:consumer:dry": "wrangler deploy --config wrangler.production.toml --env consumer --dry-run --outdir=dist/consumer",
    "deploy:production:pruner": "wrangler deploy --config wrangler.production.toml --env pruner",
    "deploy:production:pruner:dry": "wrangler deploy --config wrangler.production.toml --env pruner --dry-run --outdir=dist/pruner",
    "deploy:production:dlq": "wrangler deploy --config wrangler.production.toml --env dlq",
    "deploy:production:dlq:dry": "wrangler deploy --config wrangler.production.toml --env dlq --dry-run --outdir=dist/dlq",
    "deploy:production:all": "pnpm deploy:production && pnpm deploy:production:relay && pnpm deploy:production:consumer && pnpm deploy:production:pruner && pnpm deploy:production:dlq",
    "deploy:production:all:dry": "pnpm deploy:production:dry && pnpm deploy:production:relay:dry && pnpm deploy:production:consumer:dry && pnpm deploy:production:pruner:dry && pnpm deploy:production:dlq:dry",
    "db:generate": "drizzle-kit generate --config=./drizzle.config.ts",
    "db:apply:local": "wrangler d1 migrations apply tanstack-start-template-d1 --local",
    "db:apply:staging": "wrangler d1 migrations apply tanstack-start-template-d1-staging --remote --config wrangler.staging.toml",
    "db:apply:production": "wrangler d1 migrations apply tanstack-start-template-d1-production --remote --config wrangler.production.toml",
    "db:execute:local": "wrangler d1 execute tanstack-start-template-d1 --local --file",
    "db:execute:staging": "wrangler d1 execute tanstack-start-template-d1-staging --remote --config wrangler.staging.toml --file",
    "db:execute:production": "wrangler d1 execute tanstack-start-template-d1-production --remote --config wrangler.production.toml --file"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.99.0",
    "@tanstack/react-start": "^1.99.0",
    "drizzle-orm": "^0.45.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@cloudflare/vite-plugin": "^1.36.3",
    "@cloudflare/vitest-pool-workers": "^0.16.0",
    "@cloudflare/workers-types": "^4.20260509.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router-devtools": "^1.99.0",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260206.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitejs/plugin-rsc": "^0.5.0",
    "drizzle-kit": "^0.31.8",
    "fast-check": "^4.7.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.1.5",
    "wrangler": "^4.90.0"
  },
  "pnpm": {
    "overrides": {
      "tinypool": "1.0.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
