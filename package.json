{
  "name": "tanstack-start-template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @repo/web dev",
    "dev:node": "pnpm --filter @repo/web dev:node",
    "dev:cf": "pnpm --filter @repo/web dev:cf",
    "dev:gcp": "pnpm --filter @repo/web dev:gcp",
    "build": "pnpm --filter @repo/web build",
    "build:node": "pnpm --filter @repo/web build:node",
    "build:cf": "pnpm --filter @repo/web build:cf",
    "build:aws": "pnpm --filter @repo/web build:aws",
    "build:gcp": "pnpm --filter @repo/web build:gcp",
    "start": "pnpm --filter @repo/web start",
    "start:node": "pnpm --filter @repo/web start:node",
    "start:cf": "pnpm --filter @repo/web start:cf",
    "start:gcp": "pnpm --filter @repo/web start:gcp",
    "preview": "pnpm --filter @repo/web preview",
    "typecheck": "tsgo && pnpm -r typecheck",
    "typecheck:infra": "pnpm --filter @repo/infra-aws typecheck",
    "lint": "biome lint",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run",
    "test:integration": "pnpm test:integration:node && pnpm test:integration:cf",
    "test:integration:cf": "vitest run --config vitest.config.integration.ts",
    "test:integration:node": "vitest run --config vitest.config.integration.node.ts",
    "db:migrate": "pnpm --filter @repo/web db:migrate",
    "db:migrate:node": "pnpm --filter @repo/web db:migrate:node",
    "db:migrate:cf": "pnpm --filter @repo/web db:migrate:cf",
    "db:migrate:aws": "pnpm --filter @repo/web db:migrate:aws",
    "db:migrate:gcp": "pnpm --filter @repo/web db:migrate:gcp",
    "db:generate": "pnpm --filter @repo/web db:generate",
    "db:generate:cf": "pnpm --filter @repo/web db:generate:cf",
    "db:generate:node": "pnpm --filter @repo/web db:generate:node",
    "db:apply:local": "pnpm --filter @repo/web db:apply:local",
    "db:apply:staging": "pnpm --filter @repo/web db:apply:staging",
    "db:apply:production": "pnpm --filter @repo/web db:apply:production",
    "db:execute:local": "pnpm --filter @repo/web db:execute:local",
    "db:execute:staging": "pnpm --filter @repo/web db:execute:staging",
    "db:execute:production": "pnpm --filter @repo/web db:execute:production",
    "cf:types": "pnpm --filter @repo/web cf:types",
    "deploy:staging": "pnpm --filter @repo/web deploy:staging",
    "deploy:staging:dry": "pnpm --filter @repo/web deploy:staging:dry",
    "deploy:staging:relay": "pnpm --filter @repo/web deploy:staging:relay",
    "deploy:staging:relay:dry": "pnpm --filter @repo/web deploy:staging:relay:dry",
    "deploy:staging:consumer": "pnpm --filter @repo/web deploy:staging:consumer",
    "deploy:staging:consumer:dry": "pnpm --filter @repo/web deploy:staging:consumer:dry",
    "deploy:staging:pruner": "pnpm --filter @repo/web deploy:staging:pruner",
    "deploy:staging:pruner:dry": "pnpm --filter @repo/web deploy:staging:pruner:dry",
    "deploy:staging:dlq": "pnpm --filter @repo/web deploy:staging:dlq",
    "deploy:staging:dlq:dry": "pnpm --filter @repo/web deploy:staging:dlq:dry",
    "deploy:staging:all": "pnpm --filter @repo/web deploy:staging:all",
    "deploy:staging:all:dry": "pnpm --filter @repo/web deploy:staging:all:dry",
    "deploy:production": "pnpm --filter @repo/web deploy:production",
    "deploy:production:dry": "pnpm --filter @repo/web deploy:production:dry",
    "deploy:production:relay": "pnpm --filter @repo/web deploy:production:relay",
    "deploy:production:relay:dry": "pnpm --filter @repo/web deploy:production:relay:dry",
    "deploy:production:consumer": "pnpm --filter @repo/web deploy:production:consumer",
    "deploy:production:consumer:dry": "pnpm --filter @repo/web deploy:production:consumer:dry",
    "deploy:production:pruner": "pnpm --filter @repo/web deploy:production:pruner",
    "deploy:production:pruner:dry": "pnpm --filter @repo/web deploy:production:pruner:dry",
    "deploy:production:dlq": "pnpm --filter @repo/web deploy:production:dlq",
    "deploy:production:dlq:dry": "pnpm --filter @repo/web deploy:production:dlq:dry",
    "deploy:production:all": "pnpm --filter @repo/web deploy:production:all",
    "deploy:production:all:dry": "pnpm --filter @repo/web deploy:production:all:dry",
    "deploy:aws:staging": "pnpm build:aws && pnpm --filter @repo/infra-aws deploy:staging",
    "deploy:aws:production": "pnpm build:aws && pnpm --filter @repo/infra-aws deploy:production",
    "deploy:aws:synth": "pnpm build:aws && pnpm --filter @repo/infra-aws synth",
    "deploy:aws:diff": "pnpm build:aws && pnpm --filter @repo/infra-aws diff"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "esbuild": "^0.27.7",
    "@cloudflare/vitest-pool-workers": "^0.16.4",
    "@types/node": "^25.7.0",
    "@typescript/native-preview": "7.0.0-dev.20260513.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
