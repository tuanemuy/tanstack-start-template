# All runtime configuration is supplied through Cloudflare Workers
# bindings. `APP_URL` is set in `wrangler.toml` `[vars]`; the D1
# database is bound as `DB`; `EVENTS_QUEUE` is bound on the relay /
# consumer Workers. Secrets (auth tokens, etc.) belong in
# `wrangler secret put`, not in this file.
#
# This file exists only to document `dotenv`-style overrides that
# `wrangler dev --local` will surface as `[vars]` during local
# development. Production reads from Cloudflare's environment.
APP_URL=http://localhost:8787
