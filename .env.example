APP_URL=http://localhost:5173

ADMIN_USERNAME=admin@test
ADMIN_NAME="テスト管理者"
ADMIN_PASSWORD=Admin123!

# =============================================================================
# Database (SQLite / Turso)
# =============================================================================
# For local development (SQLite file):
SQLITE_URL=file:./data/local.db
# For production (Turso):
# SQLITE_URL=libsql://your-database.turso.io?authToken=your-auth-token
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# =============================================================================
# Session
# =============================================================================
SESSION_SECRET=your-session-secret-min-32-chars

# =============================================================================
# AWS S3 (Image & File Storage)
# =============================================================================
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=your-bucket-name
# Optional: Custom endpoint for local development (e.g., MinIO, LocalStack)
# S3_ENDPOINT=http://localhost:9000

# =============================================================================
# OpenAI (via Vercel AI SDK - LLM & OCR)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key
# Optional: Model name (default: gpt-4o)
# OPENAI_MODEL=gpt-4o
# Optional: Custom base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# =============================================================================
# OpenWeather API
# =============================================================================
OPENWEATHER_API_KEY=your-openweather-api-key
