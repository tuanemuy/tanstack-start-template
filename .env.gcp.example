# Environment variables for the GCP runtime (Cloud Run + Turso + Pub/Sub).
# Copy this file to `.env.gcp` for local migration / scripting and set
# the equivalent values in Terraform / `gcloud run deploy --set-env-vars`
# for the deployed services.
#
# `wrangler*.toml`, `.env.example`, and `.env.aws.example` are kept
# separately for the Cloudflare, Node, and AWS runtimes respectively.

# --- Required ----------------------------------------------------------------

# Turso (libSQL remote) URL. Production deployments must use `libsql://`.
# A `file:` URL is technically supported for local debugging but defeats
# the purpose of the GCP runtime.
DATABASE_URL=libsql://your-database-region.turso.io

# Bearer token for the Turso database. Issue per-environment via
# `turso db tokens create`. In production, store the token in Secret
# Manager and reference it from Terraform; the Cloud Run boot loader
# reads `DATABASE_AUTH_TOKEN_SECRET_NAME` and pre-populates this var.
DATABASE_AUTH_TOKEN=

# Public origin of the app. Set this to the Cloud Run service URL (or
# the load balancer / custom domain in front of it). Used to build
# absolute URLs for OAuth callbacks etc.
APP_URL=https://your-app.example.com

# Role of this Cloud Run service. Drives the role dispatch in
# `app/server.gcp.ts`. One of `app` (default), `relay`, `consumer`, `dlq`.
WORKER_ROLE=app

# --- Required (Cloud Run services) ------------------------------------------

# GCP project the Pub/Sub client should target. The SDK also picks this
# up from the Cloud Run metadata server automatically; set it explicitly
# when running `migrate.gcp` from a developer machine.
#GCP_PROJECT_ID=your-gcp-project

# Pub/Sub topic name (no `projects/...` prefix). The relay service
# publishes here, the consumer subscribes to it via a push subscription.
#EVENTS_TOPIC=events

# Relay Cloud Run service URL. The app service POSTs here (with an OIDC
# token) after a UoW commit; the relay service also self-kicks via this
# URL when a tick saturates `maxIterations`.
#RELAY_URL=https://relay-xxxx-uc.a.run.app

# --- Optional: secrets bootstrap --------------------------------------------

# Secret Manager version name that holds the Turso auth token. When set,
# the boot hook fetches the secret value at cold start and populates
# `DATABASE_AUTH_TOKEN` before the libSQL client is built. Cloud Run's
# built-in secret mounting usually removes the need for this.
#DATABASE_AUTH_TOKEN_SECRET_NAME=projects/your-gcp-project/secrets/database-auth-token/versions/latest

# --- Optional: outbox / worker tuning ---------------------------------------
# These mirror the wrangler `[vars]` of the same names. Unset values fall
# back to the defaults in `app/core/application/workers/`.

#OUTBOX_BATCH_SIZE=25
#OUTBOX_LEASE_MS=30000
#OUTBOX_MAX_ATTEMPTS=3
#OUTBOX_RETENTION_MS=604800000

# --- Optional: HTTP listener -------------------------------------------------

# Cloud Run injects PORT=8080 automatically; override only for local
# testing.
#PORT=8080
#HOSTNAME=0.0.0.0
