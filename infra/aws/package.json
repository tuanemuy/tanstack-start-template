{
  "name": "@repo/infra-aws",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build:web": "pnpm --filter @repo/web build:aws",
    "synth": "pnpm build:web && cdk synth",
    "diff": "pnpm build:web && cdk diff",
    "deploy:staging": "pnpm build:web && cdk deploy AppStack-staging",
    "deploy:production": "pnpm build:web && cdk deploy AppStack-production"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.180.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@repo/web": "workspace:*",
    "aws-cdk": "^2.180.0",
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
