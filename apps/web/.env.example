# Environment variables for the Node runtime (`pnpm dev:node` /
# `pnpm start:node`). Copy this file to `.env` and edit. dotenv loads
# `.env` at the entry points (`app/listen.node.ts`,
# `scripts/migrate.node.ts`), so any process that goes through those
# scripts sees these values.
#
# For the Cloudflare runtime use `.dev.vars` (auto-loaded by wrangler)
# and `wrangler*.toml` `[vars]` — see `.dev.vars.example`.

# --- Required ----------------------------------------------------------------

# libSQL URL. The default is an on-disk file under `./data/` (gitignored).
# Use `:memory:` for ephemeral runs (the runtime skips WAL mode in that case)
# or a `libsql://…` URL for remote Turso instances.
DATABASE_URL=file:./data/app.db

# Public origin of the app. Used to build absolute URLs for client-side
# fetches, OAuth callbacks, etc. Match the host:port the listener binds to.
APP_URL=http://localhost:3000

# --- Optional: database credentials -----------------------------------------

# Bearer token for remote libSQL / Turso deployments. Leave unset for local
# file-backed databases.
#DATABASE_AUTH_TOKEN=

# Encryption key for libSQL encrypted databases. Leave unset for plaintext.
#DATABASE_ENCRYPTION_KEY=

# --- Optional: HTTP listener -------------------------------------------------

# Port the Node HTTP server listens on. Defaults to 3000.
#PORT=3000

# Hostname the Node HTTP server binds to. Defaults to 0.0.0.0.
#HOSTNAME=0.0.0.0

# --- Optional: outbox / worker tuning ----------------------------------------
# These mirror the wrangler `[vars]` of the same names. Unset values fall back
# to the defaults declared in `app/core/application/workers/`.

# Max outbox rows claimed per relay tick.
#OUTBOX_BATCH_SIZE=25

# Lease window (ms) before a stuck claim becomes reclaimable.
#OUTBOX_LEASE_MS=30000

# Per-event max attempts before quarantine (`failed_at` stamp).
#OUTBOX_MAX_ATTEMPTS=3

# Retention window (ms) before processed outbox rows are pruned.
#OUTBOX_RETENTION_MS=604800000
