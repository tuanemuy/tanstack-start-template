# Environment variables for the AWS runtime (Lambda + Turso + SQS).
# Copy this file to `.env.aws` for local migration / scripting and set
# the equivalent values in CDK / Lambda environment variables for the
# deployed functions.
#
# `wrangler*.toml` and `.env.example` are kept separately for the
# Cloudflare and Node runtimes respectively.

# --- Required ----------------------------------------------------------------

# Turso (libSQL remote) URL. Production deployments must use `libsql://`.
# A `file:` URL is technically supported for local debugging but defeats
# the purpose of the AWS runtime.
DATABASE_URL=libsql://your-database-region.turso.io

# Bearer token for the Turso database. Issue per-environment via
# `turso db tokens create`. In production, store the token in Secrets
# Manager and reference it from CDK; the Lambda boot loader reads
# `DATABASE_AUTH_TOKEN_SECRET_ARN` and pre-populates this var.
DATABASE_AUTH_TOKEN=

# Public origin of the app. After the first `cdk deploy`, set this to
# the `DistributionUrl` stack output (CloudFront fronts both the
# API Gateway and the static-asset S3 bucket). Used to build absolute
# URLs for OAuth callbacks etc.
APP_URL=https://your-app.example.com

# --- Required (Lambdas) ------------------------------------------------------

# AWS region for SQS / Lambda SDK clients. The SDK also picks this up
# from `AWS_REGION` automatically inside Lambda; set it explicitly when
# running `migrate.aws` from a developer machine.
#AWS_REGION=us-east-1

# SQS queue URL the relay Lambda publishes to. Provided by CDK output.
#EVENTS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/events

# Function name (or ARN) of the relay Lambda. The request-path Lambda
# uses this to async-invoke the relay after a UoW commit. Provided by
# CDK output.
#RELAY_FUNCTION_NAME=tanstack-start-template-relay

# --- Optional: secrets bootstrap --------------------------------------------

# Secrets Manager ARN that holds the Turso auth token. When set, the
# request-path Lambda fetches the secret value at cold start and
# populates `DATABASE_AUTH_TOKEN` before the libSQL client is built.
#DATABASE_AUTH_TOKEN_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:turso-auth-token

# --- Optional: outbox / worker tuning ---------------------------------------
# These mirror the wrangler `[vars]` of the same names. Unset values fall
# back to the defaults in `packages/core/src/config.ts`.

#OUTBOX_BATCH_SIZE=25
#OUTBOX_LEASE_MS=30000
#OUTBOX_MAX_ATTEMPTS=3
#OUTBOX_RETENTION_MS=604800000
